# Скопируй в backend/.env и заполни. Сгенерировать секретный ключ:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SECRET_KEY=ЗАМЕНИ_на_длинную_случайную_строку
DJANGO_DEBUG=0

# Домен(ы) и IP сервера
DJANGO_ALLOWED_HOSTS=qptool.ru,www.qptool.ru,80.87.110.199
DJANGO_CSRF_TRUSTED_ORIGINS=https://qptool.ru,https://www.qptool.ru

# Фронт и API на одном домене → CORS не нужен
DJANGO_CORS_ALLOW_ALL=0

# HTTPS-редирект: 0 — пока нет сертификата (тест по http),
# 1 — ПОСЛЕ настройки certbot. Иначе сайт будет кидать на https без сертификата.
DJANGO_SECURE_SSL_REDIRECT=0

DJANGO_LANGUAGE_CODE=ru-ru
DJANGO_TIME_ZONE=Asia/Yekaterinburg

# База: пусто = SQLite (файл backend/db.sqlite3 — простой и надёжный вариант).
# Для PostgreSQL заполни POSTGRES_*.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
