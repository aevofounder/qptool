# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=ru-ru
DJANGO_TIME_ZONE=Asia/Yekaterinburg

# --- CORS (frontend origins that may call the API) ---
DJANGO_CORS_ALLOW_ALL=1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Leave POSTGRES_DB empty to use SQLite (default for local dev).
# Set these to switch to PostgreSQL (recommended for production):
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
