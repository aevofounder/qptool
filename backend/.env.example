# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 1 — разработка; 0 — продакшен (включает security-хардненинг ниже).
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=ru-ru
DJANGO_TIME_ZONE=Asia/Yekaterinburg

# --- CORS (frontend origins that may call the API) ---
# В продакшене выключите ALLOW_ALL и перечислите конкретные origin'ы фронтенда.
DJANGO_CORS_ALLOW_ALL=1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (действует только при DJANGO_DEBUG=0) ---
# Принудительный редирект на HTTPS (за прокси, который ставит X-Forwarded-Proto).
DJANGO_SECURE_SSL_REDIRECT=1
# Срок HSTS в секундах (по умолчанию 31536000 = 1 год). 0 — отключить.
DJANGO_HSTS_SECONDS=31536000

# --- Anti-spam / throttling ---
# Лимит анонимных отправок формы заявки на клиента.
DJANGO_LEADS_THROTTLE=20/hour

# --- Database ---
# Leave POSTGRES_DB empty to use SQLite (default for local dev).
# Set these to switch to PostgreSQL (recommended for production):
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
