# Base URL for the Django API. Leave as the relative default to use the Vite
# dev proxy (recommended in development). In production set the full origin,
# e.g. https://api.qptool.ru/api
VITE_API_BASE=/api

# Абсолютный адрес сайта — для canonical/og:url/sitemap. По умолчанию
# https://qptool.ru. Меняйте при смене домена.
VITE_SITE_URL=https://qptool.ru

# --- Аналитика (подключается только если задан ID) ---
# Яндекс.Метрика — основной счётчик для аудитории РФ. Номер счётчика:
VITE_YANDEX_METRIKA_ID=
# Google Analytics 4 (опционально; может быть недоступен в РФ). ID вида G-XXXXXXX:
VITE_GA_MEASUREMENT_ID=
